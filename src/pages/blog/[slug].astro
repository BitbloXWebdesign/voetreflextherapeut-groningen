---
import Layout from '../../layouts/Layout.astro';
import blogs from '../../data/blogs.json';

export async function getStaticPaths() {
  return blogs.map(blog => ({
    params: { slug: blog.slug },
    props: { blog }
  }));
}

const { blog } = Astro.props;
---

<Layout
  title={`${blog.title} - Voetreflextherapeut Groningen`}
  description={blog.excerpt}
>
  <div class="page-header">
    <div class="container">
      <span class="section-subtitle">{blog.category} • {blog.readTime}</span>
      <h1>{blog.title}</h1>
      <p class="page-header-desc">Gepubliceerd op {blog.date} door Georgette Noordberger</p>
    </div>
  </div>

  <section class="section section-light">
    <div class="container article-container">
      <!-- Summary Capsule -->
      <div class="answer-capsule">
        <div class="answer-capsule-text">{blog.answerCapsule}</div>
      </div>

      <!-- Main Article HTML -->
      <div class="article-content" set:html={blog.content} />

      <div class="article-author-box card mt-4">
        <h3>Over de Auteur</h3>
        <p>
          <strong>Georgette Noordberger</strong> is gediplomeerd HBO Voetreflex Plus Therapeut, Oncoreflex Master en Kraamverzorgende IG met een praktijk aan de Bieslookstraat 31 in Groningen.
        </p>
        <div class="mt-3">
          <a href="/contact" class="btn btn-primary btn-sm">Maak een Afspraak met Georgette</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 4rem 0;
    background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
    color: #ffffff;
    text-align: center;
  }

  .page-header h1 { color: #ffffff; margin-top: 0.5rem; max-width: 900px; margin-left: auto; margin-right: auto; }
  .page-header-desc { color: #cbd5e1; font-size: 1.1rem; margin-top: 0.5rem; }

  .article-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .article-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #334155;
  }

  .article-content blockquote {
    background-color: var(--color-primary-light);
    border: 1px solid rgba(32, 130, 84, 0.2);
    padding: 1.2rem 1.5rem;
    border-radius: var(--radius-sm);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .article-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
  }

  .article-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.8rem;
    color: var(--color-secondary);
  }

  .article-content :global(p) {
    margin-bottom: 1.2rem;
  }

  .article-content :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-author-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }
</style>
