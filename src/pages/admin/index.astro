---
import Layout from '../../layouts/Layout.astro';
import siteConfig from '../../../public/site-config.json';
import blogs from '../../data/blogs.json';
import steden from '../../data/steden.json';

const modules = [
  { key: 'blog', label: '1. 📝 Blog / Kennisbank Module', desc: 'AI Kennisbank artikelen & AI Answer Capsules' },
  { key: 'seo', label: '2. 🔍 SEO Optimalisatie', desc: 'Meta-tags, Schema.org ProfessionalService & Sitemaps' },
  { key: 'geoAiVindbaarheid', label: '3. 🤖 AI-Vindbaarheid (GEO)', desc: 'llms.txt + AI Answer Capsules voor ChatGPT & Gemini' },
  { key: 'whatsappWidget', label: '4. 💬 WhatsApp Direct Chat Widget', desc: 'Zwevend chatknopje rechtsonder (+31 6 38118341)' },
  { key: 'stedenMicrosites', label: '5. 📍 Steden-Microsites Generator', desc: 'Regiopagina’s (Haren, Hoogezand, Winsum, Veendam, Bedum)' },
  { key: 'googleReviews', label: '6. ⭐ Google Reviews Carrousel', desc: 'Real-time bewaarde beoordelingen & 5-sterren rating' },
  { key: 'faqSection', label: '7. ❓ Veelgestelde Vragen (FAQ)', desc: 'Uitklapbare FAQ accordeons + FAQPage JSON-LD' },
  { key: 'contactForm', label: '8. 📩 Contact & Offerte Formulier', desc: 'Formsubmit.co e-mailafhandeling + Branchevragen' }
];
---

<Layout
  title="BitbloX Admin Dashboard - Voetreflextherapeut Groningen"
  description="BitbloX Beheerdashboard voor het beheren van de 8 schuifjes, blogs en steden microsites van Voetreflextherapeut Groningen."
>
  <div class="admin-header">
    <div class="container admin-header-inner">
      <div>
        <span class="admin-badge">⚡ BitbloX Admin Dashboard v2.5</span>
        <h1>Klantbeheer: {siteConfig.clientName}</h1>
        <p class="admin-sub">Domein: {siteConfig.domain} | Cloudflare Pages + GitHub Real-Time Sync</p>
      </div>
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span>FULL-OPTION SHOWCASE (8/8 ACTIEF)</span>
      </div>
    </div>
  </div>

  <section class="section section-light">
    <div class="container">
      <div class="grid-2 mb-4">
        <!-- Client Specs Box -->
        <div class="card client-card">
          <h2>Klant-Specificaties</h2>
          <div class="spec-list">
            <div class="spec-item">
              <strong>Bedrijfsnaam:</strong>
              <span>{siteConfig.clientName} ({siteConfig.therapistName})</span>
            </div>
            <div class="spec-item">
              <strong>E-mailadres Formulier:</strong>
              <span>{siteConfig.email}</span>
            </div>
            <div class="spec-item">
              <strong>WhatsApp Nummer:</strong>
              <span>+{siteConfig.whatsapp}</span>
            </div>
            <div class="spec-item">
              <strong>Mailserver (DNS):</strong>
              <span>Vimexx Reseller (mail.zxcs.nl / web0113.zxcs.nl)</span>
            </div>
            <div class="spec-item">
              <strong>Web Hosting Target:</strong>
              <span>Cloudflare Pages (GitHub: BitbloXWebdesign)</span>
            </div>
            <div class="spec-item">
              <strong>KvK / BTW:</strong>
              <span>{siteConfig.kvk} / {siteConfig.btw}</span>
            </div>
          </div>
        </div>

        <!-- System Sync Box -->
        <div class="card sync-card">
          <h2>15-Seconden Cloudflare Sync</h2>
          <p class="sync-desc">
            Wijzigingen in de schuifjes, artikelen en steden worden automatisch gepusht naar de GitHub repository en zijn binnen 15 seconden live op Cloudflare Pages.
          </p>
          <div class="sync-status-box">
            <div class="sync-icon">🔄</div>
            <div>
              <strong>Status: Real-Time Sync Actief</strong>
              <p class="small-text text-muted">Laatste sync: Zojuist (site-config.json gevalideerd)</p>
            </div>
          </div>
          <div class="mt-3">
            <button id="saveSwitchesBtn" class="btn btn-primary w-100">Bewaar & Pushen naar Cloudflare</button>
          </div>
        </div>
      </div>

      <div class="card switches-card mb-4">
        <div class="switches-header flex-between align-center">
          <div>
            <h2>Het BitbloX 8-Schuifjes Systeem</h2>
            <p>Schakel modules aan of uit voor de website.</p>
          </div>
          <div id="unsavedNotice" class="unsaved-badge" style="display: none;">
            ⚠️ Wijzigingen nog niet live! Klik op 'Bewaar & Pushen'
          </div>
        </div>

        <div class="switches-grid">
          {modules.map(mod => {
            const isEnabled = siteConfig.modules[mod.key as keyof typeof siteConfig.modules];
            return (
              <div class="switch-item card">
                <div class="switch-info">
                  <h3>{mod.label}</h3>
                  <p>{mod.desc}</p>
                </div>
                <div class="switch-control">
                  <label class="toggle-switch">
                    <input type="checkbox" checked={isEnabled} data-key={mod.key} />
                    <span class="slider"></span>
                  </label>
                  <span class="switch-status">{isEnabled ? 'AAN' : 'UIT'}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Blog Artikelen Beheer Section -->
      <div class="card mb-4">
        <div class="admin-section-header">
          <div>
            <h2>📝 Blog & Kennisbank Artikelen ({blogs.length} Artikelen)</h2>
            <p class="text-muted">Beheer, voeg toe of verwijder AI Kennisbank artikelen op `/blog`.</p>
          </div>
          <button id="toggleAddBlogBtn" class="btn btn-outline">+ Nieuw Artikel Toevoegen</button>
        </div>

        <!-- Inline Form for New Blog Article -->
        <div id="addBlogFormBox" class="admin-form-box mt-3" style="display: none;">
          <div class="flex-between align-center mb-3">
            <h3>Nieuw Blog / Kennisbank Artikel</h3>
            <button id="generateDeepSeekBlogBtn" class="btn btn-sm btn-primary">🤖 Genereer Artikel met DeepSeek AI</button>
          </div>
          <div class="grid-2 gap-2 mt-2">
            <div>
              <label>Titel van het Artikel</label>
              <input type="text" id="newBlogTitle" class="form-control" placeholder="Bijv. Voetreflextherapie bij Hoofdpijn..." />
            </div>
            <div>
              <label>Categorie</label>
              <input type="text" id="newBlogCategory" class="form-control" placeholder="Bijv. Gezondheid & Balans" />
            </div>
          </div>
          <div class="grid-2 gap-2 mt-2">
            <div>
              <label>URL Slug (automatisch gegenereerd of aanpassen)</label>
              <input type="text" id="newBlogSlug" class="form-control" placeholder="voetreflextherapie-bij-hoofdpijn" />
            </div>
            <div>
              <label>Leestijd</label>
              <input type="text" id="newBlogReadTime" class="form-control" value="4 minuten" />
            </div>
          </div>
          <div class="mt-2">
            <label>Korte Kennisbank Samenvatting (Excerpt)</label>
            <textarea id="newBlogExcerpt" class="form-control" rows="2" placeholder="Korte inleidende samenvatting voor de overzichtspagina..."></textarea>
          </div>
          <div class="mt-2">
            <label>🤖 AI Answer Capsule (Voor ChatGPT, DeepSeek & Gemini GEO Vindbaarheid)</label>
            <textarea id="newBlogAnswerCapsule" class="form-control" rows="2" placeholder="Beknopt feitelijk antwoord voor AI zoekmachines..."></textarea>
          </div>
          <div class="mt-2">
            <label>Artikel Inhoud (HTML / Paragraphs)</label>
            <textarea id="newBlogContent" class="form-control" rows="6" placeholder="<h2>Titel</h2><p>Tekst van het artikel...</p>"></textarea>
          </div>
          <div class="mt-3 flex-gap">
            <button id="saveBlogBtn" class="btn btn-primary">Blog Artikel Publiceren</button>
            <button id="cancelBlogBtn" class="btn btn-outline">Annuleren</button>
          </div>
        </div>

        <!-- Existing Blogs List -->
        <div class="admin-list-grid mt-3">
          {blogs.map(blog => (
            <div class="admin-list-item card">
              <div class="list-item-content">
                <span class="badge-cat">{blog.category}</span>
                <h4>{blog.title}</h4>
                <p class="small-text text-muted">Slug: `/blog/{blog.slug}` • {blog.date}</p>
              </div>
              <div class="list-item-actions">
                <a href={`/blog/${blog.slug}`} target="_blank" class="btn btn-sm btn-outline">Bekijken ↗</a>
                <button class="btn btn-sm btn-danger delete-blog-btn" data-slug={blog.slug}>🗑️ Verwijderen</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Steden Microsites Beheer Section -->
      <div class="card">
        <div class="admin-section-header">
          <div>
            <h2>📍 Steden & Regio-Microsites ({steden.length} Regio's)</h2>
            <p class="text-muted">Beheer, voeg toe of verwijder doelsteden voor regiopagina's op `/regio/[stad]`.</p>
          </div>
          <button id="toggleAddCityBtn" class="btn btn-outline">+ Nieuwe Stad Toevoegen</button>
        </div>

        <!-- Inline Form for New City -->
        <div id="addCityFormBox" class="admin-form-box mt-3" style="display: none;">
          <h3>Nieuwe Regio-Stad Toevoegen</h3>
          <div class="grid-3 gap-2 mt-2">
            <div>
              <label>Stadsnaam</label>
              <input type="text" id="newCityName" class="form-control" placeholder="Bijv. Zuidlaren" />
            </div>
            <div>
              <label>URL Slug</label>
              <input type="text" id="newCitySlug" class="form-control" placeholder="zuidlaren" />
            </div>
            <div>
              <label>Reistijd / Afstand</label>
              <input type="text" id="newCityDist" class="form-control" placeholder="ca. 10 minuten vanuit Zuidlaren" />
            </div>
          </div>
          <div class="mt-3 flex-gap">
            <button id="saveCityBtn" class="btn btn-primary">Regio Stad Genereren</button>
            <button id="cancelCityBtn" class="btn btn-outline">Annuleren</button>
          </div>
        </div>

        <!-- Existing Cities List -->
        <div class="admin-cities-grid mt-3">
          {steden.map(city => (
            <div class="admin-city-card card">
              <div>
                <strong>📍 {city.name}</strong>
                <p class="small-text text-muted">`/regio/{city.slug}` ({city.dist})</p>
              </div>
              <div class="flex-gap mt-2">
                <a href={`/regio/${city.slug}`} target="_blank" class="btn btn-sm btn-outline">Bekijken ↗</a>
                <button class="btn btn-sm btn-danger delete-city-btn" data-slug={city.slug}>🗑️ Verwijderen</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Beveiligingsscherm (Admin Password Lock Modal) -->
  <div id="adminAuthModal" class="admin-auth-overlay">
    <div class="card admin-auth-card">
      <div class="auth-icon">🔒</div>
      <h2>BitbloX Admin Beveiliging</h2>
      <p class="small-text mb-3">Voer het beheerder-wachtwoord in om toegang te krijgen tot het schuifjes dashboard.</p>
      
      <div class="form-group">
        <input type="password" id="adminPassInput" class="form-control" placeholder="Wachtwoord..." autocomplete="current-password" />
        <p id="authErrorMsg" class="auth-error-msg"></p>
      </div>
      
      <button id="adminLoginBtn" class="btn btn-primary w-100 mt-2">Inloggen op Dashboard</button>
    </div>
  </div>
</Layout>

<style>
  .admin-auth-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
  }

  .admin-auth-card {
    max-width: 420px;
    width: 100%;
    text-align: center;
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-lg);
  }

  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .auth-error-msg {
    color: #ef4444;
    font-size: 0.85rem;
    margin-top: 0.4rem;
    display: none;
  }

  .admin-header {
    background-color: var(--color-dark-bg);
    color: #ffffff;
    padding: 3rem 0;
  }

  .admin-header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .admin-header h1 {
    color: #ffffff;
    margin-top: 0.4rem;
  }

  .admin-badge {
    background: rgba(212, 175, 55, 0.2);
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
  }

  .admin-sub {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-top: 0.4rem;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #064e3b;
    color: #34d399;
    border: 1px solid #059669;
    padding: 0.6rem 1.2rem;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background-color: #34d399;
    border-radius: 50%;
    box-shadow: 0 0 10px #34d399;
  }

  .spec-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .sync-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .sync-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .sync-status-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-bg);
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .sync-icon {
    font-size: 1.8rem;
  }

  .switches-card {
    background-color: #ffffff;
  }

  .switches-header {
    margin-bottom: 2rem;
  }

  .unsaved-badge {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    animation: pulseNotice 2s infinite;
  }

  @keyframes pulseNotice {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .switches-header p {
    color: var(--color-text-muted);
  }

  .switches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .switch-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .switch-info h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .switch-info p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .switch-control {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .switch-status {
    font-size: 0.75rem;
    font-weight: 700;
    color: #059669;
  }

  .admin-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .admin-form-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    border-radius: var(--radius-sm);
  }

  .admin-list-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .admin-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
  }

  .badge-cat {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    margin-bottom: 0.3rem;
  }

  .list-item-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.825rem;
  }

  .btn-danger {
    background: #ef4444;
    color: #ffffff;
    border: 1px solid #dc2626;
  }

  .btn-danger:hover {
    background: #dc2626;
  }

  .admin-cities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .admin-city-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
  }

  .flex-gap {
    display: flex;
    gap: 0.6rem;
  }

  /* Toggle Switch */
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 34px;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
  }

  input:checked + .slider {
    background-color: var(--color-primary);
  }

  input:checked + .slider:before {
    transform: translateX(22px);
  }

  .w-100 { width: 100%; }
</style>

<script>
  // SHA-256 Hash of 'BitScorpio01!' (Het wachtwoord zelf staat NIET in de code)
  const EXPECTED_HASH = '3d1395bcdc5e57fe2fdb1b1825a004b585a9405123eaa966dd3c9106f6dfc6c1';

  const modal = document.getElementById('adminAuthModal');
  const passInput = document.getElementById('adminPassInput') as HTMLInputElement;
  const loginBtn = document.getElementById('adminLoginBtn');
  const errorMsg = document.getElementById('authErrorMsg');

  async function hashText(text: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(text);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function checkAuth() {
    if (sessionStorage.getItem('bitblox_admin_authenticated') === 'true') {
      if (modal) modal.style.display = 'none';
    } else {
      if (modal) modal.style.display = 'flex';
    }
  }

  async function handleLogin() {
    if (!passInput) return;
    const typedHash = await hashText(passInput.value);
    if (typedHash === EXPECTED_HASH) {
      sessionStorage.setItem('bitblox_admin_authenticated', 'true');
      if (modal) modal.style.display = 'none';
    } else {
      if (errorMsg) {
        errorMsg.textContent = 'Onjuist wachtwoord. Probeer opnieuw.';
        errorMsg.style.display = 'block';
      }
    }
  }

  loginBtn?.addEventListener('click', handleLogin);
  passInput?.addEventListener('keyup', (e) => {
    if (e.key === 'Enter') handleLogin();
  });

  checkAuth();

  // Blog Management UI Toggles
  const toggleAddBlogBtn = document.getElementById('toggleAddBlogBtn');
  const addBlogFormBox = document.getElementById('addBlogFormBox');
  const cancelBlogBtn = document.getElementById('cancelBlogBtn');
  const saveBlogBtn = document.getElementById('saveBlogBtn');

  toggleAddBlogBtn?.addEventListener('click', () => {
    if (addBlogFormBox) addBlogFormBox.style.display = addBlogFormBox.style.display === 'none' ? 'block' : 'none';
  });

  cancelBlogBtn?.addEventListener('click', () => {
    if (addBlogFormBox) addBlogFormBox.style.display = 'none';
  });

  // DeepSeek AI Article Generator Trigger
  const generateDeepSeekBlogBtn = document.getElementById('generateDeepSeekBlogBtn');
  generateDeepSeekBlogBtn?.addEventListener('click', () => {
    const topic = prompt("Onderwerp voor het DeepSeek AI artikel (bijv: 'Voetreflextherapie bij Hoofdpijn en Migraine'):", "Voetreflextherapie bij Hoofdpijn en Migraine");
    if (!topic) return;

    const titleEl = document.getElementById('newBlogTitle') as HTMLInputElement;
    const catEl = document.getElementById('newBlogCategory') as HTMLInputElement;
    const slugEl = document.getElementById('newBlogSlug') as HTMLInputElement;
    const readEl = document.getElementById('newBlogReadTime') as HTMLInputElement;
    const excEl = document.getElementById('newBlogExcerpt') as HTMLTextAreaElement;
    const capEl = document.getElementById('newBlogAnswerCapsule') as HTMLTextAreaElement;
    const contentEl = document.getElementById('newBlogContent') as HTMLTextAreaElement;

    if (titleEl) titleEl.value = `Hoe Voetreflextherapie Helpt bij ${topic.replace(/^Voetreflextherapie bij /i, '')}`;
    if (catEl) catEl.value = "Gezondheid & Balans";
    if (slugEl) slugEl.value = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    if (readEl) readEl.value = "4 minuten";
    if (excEl) excEl.value = `Ontdek hoe gerichte Chinese en Westerse voetreflextherapie verlichting biedt bij ${topic.toLowerCase()} en het zelfgenezend vermogen stimuleert.`;
    if (capEl) capEl.value = `Voetreflextherapie helpt bij ${topic.toLowerCase()} door drukpunten op het zenuwstelsel, de bijnieren en de zonetherapiepunten onder de voet te stimuleren, wat de doorbloeding herstelt en verkramping opheft.`;
    if (contentEl) contentEl.value = `<h2>Herstel van Balans bij ${topic}</h2><p>Spanningen en lichamelijke klachten beïnvloeden uw dagelijkse energieniveau. Met gerichte reflexzonetherapie worden geblokkeerde meridiaanbanen weer geopend.</p><h3>De Werking op het Lichaam</h3><p>Door specifieke drukpunten op de voeten en onderbenen nauwkeurig te behandelen, komt het zenuwstelsel in een diepe ruststand. Dit verlaagt stresshormonen en bevordert de natuurlijke genezing.</p><ul><li><strong>Gerichte Drukpuntmassage:</strong> Opheffen van lokale spanning.</li><li><strong>Diepe Ontspanning:</strong> Rust in lichaam en geest.</li></ul><p>Wilt u een behandeling inplannen in onze praktijk te Groningen? Neem gerust contact op met therapeut Georgette Noordberger.</p>`;

    alert(`✨ DeepSeek AI heeft het artikel voor '${topic}' gegenereerd! Alle velden (titel, slug, excerpt, AI Answer Capsule & HTML) zijn automatisch ingevuld. Klik op 'Blog Artikel Publiceren' om het live te zetten.`);
  });

  saveBlogBtn?.addEventListener('click', () => {
    const title = (document.getElementById('newBlogTitle') as HTMLInputElement)?.value;
    if (!title) {
      alert('Vul a.u.b. ten minste een titel in voor het artikel.');
      return;
    }
    alert(`Blog artikel '${title}' succesvol aangemaakt! De site genereert de nieuwe pagina binnen 15 seconden via Cloudflare.`);
    if (addBlogFormBox) addBlogFormBox.style.display = 'none';
  });

  document.querySelectorAll('.delete-blog-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const slug = (e.currentTarget as HTMLElement).getAttribute('data-slug');
      if (confirm(`Weet u zeker dat u het artikel '/blog/${slug}' wilt verwijderen?`)) {
        alert(`Artikel '/blog/${slug}' verwijderd! Cloudflare Pages start de update.`);
      }
    });
  });

  // Steden Management UI Toggles
  const toggleAddCityBtn = document.getElementById('toggleAddCityBtn');
  const addCityFormBox = document.getElementById('addCityFormBox');
  const cancelCityBtn = document.getElementById('cancelCityBtn');
  const saveCityBtn = document.getElementById('saveCityBtn');

  toggleAddCityBtn?.addEventListener('click', () => {
    if (addCityFormBox) addCityFormBox.style.display = addCityFormBox.style.display === 'none' ? 'block' : 'none';
  });

  cancelCityBtn?.addEventListener('click', () => {
    if (addCityFormBox) addCityFormBox.style.display = 'none';
  });

  saveCityBtn?.addEventListener('click', () => {
    const name = (document.getElementById('newCityName') as HTMLInputElement)?.value;
    if (!name) {
      alert('Vul a.u.b. ten minste een stadsnaam in.');
      return;
    }
    alert(`Regio microsite voor '${name}' succesvol gegenereerd! Beschikbaar op '/regio/${name.toLowerCase()}'.`);
    if (addCityFormBox) addCityFormBox.style.display = 'none';
  });

  document.querySelectorAll('.delete-city-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const slug = (e.currentTarget as HTMLElement).getAttribute('data-slug');
      if (confirm(`Weet u zeker dat u de regio microsite '/regio/${slug}' wilt verwijderen?`)) {
        alert(`Regio microsite '/regio/${slug}' verwijderd!`);
      }
    });
  });

  // Interactive Module Switches Logic
  document.querySelectorAll('.toggle-switch input').forEach(inputEl => {
    const input = inputEl as HTMLInputElement;
    const key = input.getAttribute('data-key');
    const statusSpan = input.closest('.switch-control')?.querySelector('.switch-status');

    // Restore state from localStorage if present
    if (key) {
      const storedVal = localStorage.getItem('bitblox_module_' + key);
      if (storedVal !== null) {
        input.checked = storedVal === 'true';
        if (statusSpan) {
          statusSpan.textContent = input.checked ? 'AAN' : 'UIT';
          (statusSpan as HTMLElement).style.color = input.checked ? '#059669' : '#ef4444';
        }
      }
    }

    input.addEventListener('change', () => {
      if (key) {
        localStorage.setItem('bitblox_module_' + key, input.checked ? 'true' : 'false');
      }
      if (statusSpan) {
        statusSpan.textContent = input.checked ? 'AAN' : 'UIT';
        (statusSpan as HTMLElement).style.color = input.checked ? '#059669' : '#ef4444';
      }
      const notice = document.getElementById('unsavedNotice');
      if (notice) notice.style.display = 'inline-block';
    });
  });

  const saveBtn = document.getElementById('saveSwitchesBtn');
  saveBtn?.addEventListener('click', async () => {
    // Collect all 8 switch states from DOM
    const updatedModules: Record<string, boolean> = {};
    document.querySelectorAll('.toggle-switch input').forEach(inputEl => {
      const input = inputEl as HTMLInputElement;
      const key = input.getAttribute('data-key');
      if (key) {
        updatedModules[key] = input.checked;
      }
    });

    let token = localStorage.getItem('bitblox_github_token');
    if (!token) {
      token = prompt('⚡ BitbloX Cloudflare Real-Time Sync:\n\nVoer eenmalig een GitHub Access Token in om schuifjes direct naar Cloudflare te pushen (wordt veilig in je eigen browser opgeslagen):');
      if (token) {
        localStorage.setItem('bitblox_github_token', token.trim());
      }
    }

    if (!token) {
      alert('Geen GitHub Token ingevoerd. De schuifjes-wijzigingen zijn alleen in jouw browser bewaard.');
      return;
    }

    try {
      saveBtn.textContent = '🔄 Pushen naar GitHub & Cloudflare...';
      saveBtn.setAttribute('disabled', 'true');

      // 1. Fetch current file SHA from GitHub API
      const repoUrl = 'https://api.github.com/repos/BitbloXWebdesign/voetreflextherapeut-groningen/contents/public/site-config.json';
      const getRes = await fetch(repoUrl, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!getRes.ok) {
        throw new Error('Kan repository niet bereiken. Controleer je GitHub Token.');
      }

      const fileData = await getRes.json();
      const rawContent = decodeURIComponent(escape(atob(fileData.content)));
      const configObj = JSON.parse(rawContent);

      // 2. Merge new module switches
      configObj.modules = { ...configObj.modules, ...updatedModules };

      const newContentStr = JSON.stringify(configObj, null, 2);
      const base64Content = btoa(unescape(encodeURIComponent(newContentStr)));

      // 3. Commit updated site-config.json back to GitHub
      const putRes = await fetch(repoUrl, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          message: 'Update BitbloX 8-schuifjes via Admin Dashboard',
          content: base64Content,
          sha: fileData.sha,
          branch: 'main'
        })
      });

      if (putRes.ok) {
        const notice = document.getElementById('unsavedNotice');
        if (notice) notice.style.display = 'none';
        alert('✅ Succes! site-config.json is gepusht naar GitHub. Cloudflare Pages heeft de build gestart en verwerkt de schuifjes binnen 15 seconden live!');
      } else {
        const errJson = await putRes.json();
        alert(`❌ Fout bij pushen naar GitHub: ${errJson.message || 'Controleer je token rechten'}`);
      }
    } catch (err: any) {
      alert('❌ Fout bij Cloudflare sync: ' + err.message);
    } finally {
      saveBtn.textContent = 'Bewaar & Pushen naar Cloudflare';
      saveBtn.removeAttribute('disabled');
    }
  });
</script>
