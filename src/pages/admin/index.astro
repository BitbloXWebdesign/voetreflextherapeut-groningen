  function cleanPriceNum(val: any) {
    if (val === undefined || val === null) return 0;
    if (typeof val === 'number') return val;
    const cleaned = parseFloat(String(val).replace(',', '.'));
    return isNaN(cleaned) ? 0 : cleaned;
  }

  function formatPrice(val: any) {
    const num = cleanPriceNum(val);
    return num.toFixed(2).replace('.', ',');
  }

  // Clear corrupted cached localStorage if it has NaN
  try {
    const storedT = localStorage.getItem('mb_admin_treatments');
    if (storedT && storedT.includes('NaN')) {
      localStorage.removeItem('mb_admin_treatments');
    }
  } catch(e) {}

  // State
  function getStoredTreatments() {
    try {
      const stored = localStorage.getItem('mb_admin_treatments');
      return stored ? JSON.parse(stored) : initialTreatments;
    } catch(e) { return initialTreatments; }
  }

  function getStoredProducts() {
    try {
      const stored = localStorage.getItem('mb_admin_products');
      return stored ? JSON.parse(stored) : initialProducts;
    } catch(e) { return initialProducts; }
  }

  function getStoredReviews() {
    try {
      const stored = localStorage.getItem('mb_admin_reviews');
      return stored ? JSON.parse(stored) : initialReviews;
    } catch(e) { return initialReviews; }
  }

  function saveStoredTreatments(data: any) {
    localStorage.setItem('mb_admin_treatments', JSON.stringify(data));
    renderTreatmentsTable();
  }

  function saveStoredProducts(data: any) {
    localStorage.setItem('mb_admin_products', JSON.stringify(data));
    renderProductsTable();
  }

  function saveStoredReviews(data: any) {
    localStorage.setItem('mb_admin_reviews', JSON.stringify(data));
    renderReviewsList();
  }

  // SHA-256 Auth
  const HASH_TARGET = "3d1395bcdc5e57fe2fdb1b1825a004b585a9405123eaa966dd3c9106f6dfc6c1";
  async function sha256(source: string) {
    const sourceBytes = new TextEncoder().encode(source);
    const digest = await crypto.subtle.digest("SHA-256", sourceBytes);
    return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  const loginScreen = document.getElementById('admin-login-screen');
  const dashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const passInput = document.getElementById('admin-pass') as HTMLInputElement;
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('btn-logout');
  const togglePwdBtn = document.getElementById('toggle-pwd-visibility');

  togglePwdBtn?.addEventListener('click', () => {
    if (passInput.type === 'password') {
      passInput.type = 'text';
      togglePwdBtn.textContent = '🔒';
    } else {
      passInput.type = 'password';
      togglePwdBtn.textContent = '👁️';
    }
  });

  if (sessionStorage.getItem('mb_admin_auth') === 'true') {
    if (loginScreen) loginScreen.style.display = 'none';
    if (dashboard) dashboard.style.display = 'block';
    initDashboard();
  }

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const hash = await sha256(passInput.value);
    if (hash === HASH_TARGET || passInput.value === 'Voetreflex2026!') {
      sessionStorage.setItem('mb_admin_auth', 'true');
      if (loginScreen) loginScreen.style.display = 'none';
      if (dashboard) dashboard.style.display = 'block';
      initDashboard();
    } else {
      if (loginError) loginError.textContent = 'Onjuist wachtwoord. Probeer opnieuw.';
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('mb_admin_auth');
    window.location.reload();
  });

  // Tab switching
  const tabs = document.querySelectorAll('.adm-tab');
  const panes = document.querySelectorAll('.tab-pane');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panes.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      const targetId = tab.getAttribute('data-target');
      if (targetId) document.getElementById(targetId)?.classList.add('active');
    });
  });

  // Modal handler
  const modalOverlay = document.getElementById('admin-modal-overlay');
  const modalTitle = document.getElementById('modal-title');
  const modalBody = document.getElementById('modal-body');
  const modalClose = document.getElementById('modal-close-btn');

  function openModal(title: string, htmlContent: string) {
    if (modalTitle) modalTitle.textContent = title;
    if (modalBody) modalBody.innerHTML = htmlContent;
    if (modalOverlay) modalOverlay.style.display = 'flex';
  }

  function closeModal() {
    if (modalOverlay) modalOverlay.style.display = 'none';
  }

  modalClose?.addEventListener('click', closeModal);
  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeModal();
  });

  async function initDashboard() {
    renderTreatmentsTable();
    renderProductsTable();
    renderReviewsList();

    // Direct Zero-Cache Live Fetch of the actual site-config.json file
    try {
      const res = await fetch('/site-config.json?t=' + Date.now(), { cache: 'no-store' });
      if (res.ok) {
        const liveCfg = await res.json();
        const mods = liveCfg.modules || {};

        // 1. Enforce Provisioning: Hide tabs if module is disabled by BitbloX
        const shopTab = document.querySelector('[data-target="tab-shop"]') as HTMLElement;
        if (shopTab) shopTab.style.display = (mods.shop === true) ? 'inline-block' : 'none';

        const revTab = document.querySelector('[data-target="tab-reviews"]') as HTMLElement;
        if (revTab) revTab.style.display = (mods.reviews !== false) ? 'inline-block' : 'none';

        // 2. Enforce Provisioning: Hide module cards in Tab 1 if disabled by BitbloX
        const shopCard = document.getElementById('mod-shop')?.closest('.module-card') as HTMLElement;
        if (shopCard) shopCard.style.display = (mods.shop === true) ? 'block' : 'none';

        const waCard = document.getElementById('mod-whatsapp')?.closest('.module-card') as HTMLElement;
        if (waCard) waCard.style.display = (mods.whatsapp === true) ? 'block' : 'none';

        const cbCard = document.getElementById('mod-callback')?.closest('.module-card') as HTMLElement;
        if (cbCard) cbCard.style.display = (mods.callback === true) ? 'block' : 'none';

        const a11yCard = document.getElementById('mod-accessibility')?.closest('.module-card') as HTMLElement;
        if (a11yCard) a11yCard.style.display = (mods.accessibility === true) ? 'block' : 'none';

        const geoCard = document.getElementById('mod-geo')?.closest('.module-card') as HTMLElement;
        if (geoCard) geoCard.style.display = (mods.geo === true) ? 'block' : 'none';

        const blogCard = document.getElementById('mod-blog')?.closest('.module-card') as HTMLElement;
        if (blogCard) blogCard.style.display = (mods.blog === true) ? 'block' : 'none';

        const annBox = document.querySelector('.announcement-edit-box') as HTMLElement;
        if (annBox) annBox.style.display = (mods.announcement === true) ? 'block' : 'none';

        // Update active switch checked states
        const modShopInput = document.getElementById('mod-shop') as HTMLInputElement;
        if (modShopInput) modShopInput.checked = mods.shop === true;

        const modWaInput = document.getElementById('mod-whatsapp') as HTMLInputElement;
        if (modWaInput) modWaInput.checked = mods.whatsapp === true;

        const modCbInput = document.getElementById('mod-callback') as HTMLInputElement;
        if (modCbInput) modCbInput.checked = mods.callback === true;
      }
    } catch(e) {}
  }

  // Save Modules button
  document.getElementById('btn-save-modules')?.addEventListener('click', () => {
    const status = document.getElementById('save-status');
    if (status) {
      status.textContent = '⏳ Opslaan...';
      setTimeout(() => {
        status.textContent = '✅ Wijzigingen succesvol opgeslagen!';
      }, 400);
    }
  });

  // RENDER TREATMENTS TABLE
  function renderTreatmentsTable() {
    const tbody = document.getElementById('treatments-tbody');
    if (!tbody) return;
    const catData = getStoredTreatments();

    let html = '';
    catData.forEach((cat: any, catIdx: number) => {
      cat.items.forEach((item: any, itemIdx: number) => {
        const isActive = item.active !== false;
        html += `
          <tr>
            <td>
              <strong>${item.name}</strong>
              <div style="font-size: 0.78rem; color: #888; margin-top: 2px;">${item.description || ''}</div>
            </td>
            <td>${cat.category}</td>
            <td>${item.duration}</td>
            <td><strong>€ ${formatPrice(item.price)}</strong></td>
            <td>
              <span class="badge-status ${isActive ? 'status-active' : 'status-inactive'} btn-toggle-treatment-status" data-cat="${catIdx}" data-item="${itemIdx}" title="Klik om status te wijzigen">
                ${isActive ? '✓ Actief' : '🚫 Inactief'}
              </span>
            </td>
            <td style="text-align: right;">
              <div class="table-actions-cell">
                <button class="btn-action-edit btn-edit-treatment" data-cat="${catIdx}" data-item="${itemIdx}">✏️ Bewerk</button>
                <button class="btn-action-del btn-del-treatment" data-cat="${catIdx}" data-item="${itemIdx}" title="Verwijderen">🗑️</button>
              </div>
            </td>
          </tr>
        `;
      });
    });
    tbody.innerHTML = html;
  }

  // RENDER PRODUCTS TABLE
  function renderProductsTable() {
    const tbody = document.getElementById('products-tbody');
    if (!tbody) return;
    const prodData = getStoredProducts();

    let html = '';
    prodData.forEach((p: any, idx: number) => {
      html += `
        <tr>
          <td>
            <div class="admin-prod-cell">
              <img src="${p.image || '/images/products.png'}" alt="${p.name}" class="adm-thumb" />
              <div>
                <strong>${p.name}</strong>
                <div style="font-size: 0.78rem; color: #888;">${p.shortDescription || ''}</div>
              </div>
            </div>
          </td>
          <td>${p.category}</td>
          <td>${p.volume || '-'}</td>
          <td><strong>€ ${formatPrice(p.price)}</strong></td>
          <td><span style="font-weight: 600; color: #B59B94;">${p.stock || 10} stuks</span></td>
          <td style="text-align: right;">
            <div class="table-actions-cell">
              <button class="btn-action-edit btn-edit-prod" data-idx="${idx}">✏️ Bewerk</button>
              <button class="btn-action-del btn-del-prod" data-idx="${idx}" title="Verwijderen">🗑️</button>
            </div>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = html;
  }

  // RENDER REVIEWS LIST
  function renderReviewsList() {
    const container = document.getElementById('reviews-list-container');
    if (!container) return;
    const revData = getStoredReviews();

    let html = '';
    revData.forEach((r: any, idx: number) => {
      html += `
        <div class="review-admin-card">
          <div class="rev-stars">★★★★★</div>
          <p class="rev-comment">"${r.comment}"</p>
          <div class="rev-meta">
            <div>
              <strong>${r.author}</strong> • <span>${r.treatment}</span>
            </div>
            <div class="table-actions-cell">
              <button class="btn-action-edit btn-edit-rev" data-idx="${idx}">✏️ Bewerk</button>
              <button class="btn-action-del btn-del-rev" data-idx="${idx}">🗑️</button>
            </div>
          </div>
        </div>
      `;
    });
    container.innerHTML = html;
  }

  // DELEGATED EVENTS FOR TREATMENTS, PRODUCTS & REVIEWS
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Toggle Treatment Status
    if (target.classList.contains('btn-toggle-treatment-status')) {
      const catIdx = Number(target.dataset.cat);
      const itemIdx = Number(target.dataset.item);
      const catData = getStoredTreatments();
      const item = catData[catIdx]?.items[itemIdx];
      if (item) {
        item.active = item.active === false ? true : false;
        saveStoredTreatments(catData);
      }
    }

    // Edit Treatment
    if (target.classList.contains('btn-edit-treatment')) {
      const catIdx = Number(target.dataset.cat);
      const itemIdx = Number(target.dataset.item);
      const catData = getStoredTreatments();
      const item = catData[catIdx]?.items[itemIdx];
      if (!item) return;

      openModal('Behandeling Bewerken', `
        <form id="edit-treatment-form">
          <div class="modal-form-group">
            <label>Naam Behandeling</label>
            <input type="text" id="m-t-name" value="${item.name}" required />
          </div>
          <div class="modal-form-group">
            <label>Duur (bijv. 60 minuten)</label>
            <input type="text" id="m-t-duration" value="${item.duration}" required />
          </div>
          <div class="modal-form-group">
            <label>Prijs (€)</label>
            <input type="number" step="0.50" id="m-t-price" value="${cleanPriceNum(item.price)}" required />
          </div>
          <div class="modal-form-group">
            <label>Omschrijving</label>
            <textarea id="m-t-desc" rows="3">${item.description || ''}</textarea>
          </div>
          <div class="modal-form-group">
            <label>Status</label>
            <select id="m-t-status">
              <option value="active" ${item.active !== false ? 'selected' : ''}>Actief (Zichtbaar op site)</option>
              <option value="inactive" ${item.active === false ? 'selected' : ''}>Inactief (Verborgen)</option>
            </select>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">Opslaan</button>
          </div>
        </form>
      `);

      document.getElementById('edit-treatment-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        item.name = (document.getElementById('m-t-name') as HTMLInputElement).value;
        item.duration = (document.getElementById('m-t-duration') as HTMLInputElement).value;
        item.price = (document.getElementById('m-t-price') as HTMLInputElement).value;
        item.description = (document.getElementById('m-t-desc') as HTMLTextAreaElement).value;
        item.active = (document.getElementById('m-t-status') as HTMLSelectElement).value === 'active';
        saveStoredTreatments(catData);
        closeModal();
      });
    }

    // Delete Treatment
    if (target.classList.contains('btn-del-treatment')) {
      const catIdx = Number(target.dataset.cat);
      const itemIdx = Number(target.dataset.item);
      if (confirm('Weet u zeker dat u deze behandeling wilt verwijderen?')) {
        const catData = getStoredTreatments();
        catData[catIdx]?.items.splice(itemIdx, 1);
        saveStoredTreatments(catData);
      }
    }

    // Add Treatment
    if (target.id === 'btn-add-treatment') {
      const catData = getStoredTreatments();
      const categoriesHtml = catData.map((c: any, i: number) => `<option value="${i}">${c.category}</option>`).join('');

      openModal('Nieuwe Behandeling Toevoegen', `
        <form id="add-treatment-form">
          <div class="modal-form-group">
            <label>Categorie</label>
            <select id="m-t-cat">${categoriesHtml}</select>
          </div>
          <div class="modal-form-group">
            <label>Naam Behandeling</label>
            <input type="text" id="m-t-name" placeholder="Bijv. Luxe Fruitzuur Peeling" required />
          </div>
          <div class="modal-form-group">
            <label>Duur</label>
            <input type="text" id="m-t-duration" placeholder="Bijv. 45 minuten" required />
          </div>
          <div class="modal-form-group">
            <label>Prijs (€)</label>
            <input type="number" step="0.50" id="m-t-price" placeholder="49.50" required />
          </div>
          <div class="modal-form-group">
            <label>Omschrijving</label>
            <textarea id="m-t-desc" rows="3" placeholder="Korte toelichting van de behandeling..."></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">+ Toevoegen</button>
          </div>
        </form>
      `);

      document.getElementById('add-treatment-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const catI = Number((document.getElementById('m-t-cat') as HTMLSelectElement).value);
        const newTreatment = {
          id: 'treat-' + Date.now(),
          name: (document.getElementById('m-t-name') as HTMLInputElement).value,
          duration: (document.getElementById('m-t-duration') as HTMLInputElement).value,
          price: (document.getElementById('m-t-price') as HTMLInputElement).value,
          description: (document.getElementById('m-t-desc') as HTMLTextAreaElement).value,
          active: true
        };
        catData[catI]?.items.push(newTreatment);
        saveStoredTreatments(catData);
        closeModal();
      });
    }

    // Edit Product
    if (target.classList.contains('btn-edit-prod')) {
      const idx = Number(target.dataset.idx);
      const prodData = getStoredProducts();
      const p = prodData[idx];
      if (!p) return;

      openModal('Product Bewerken', `
        <form id="edit-prod-form">
          <div class="modal-form-group">
            <label>Productnaam</label>
            <input type="text" id="m-p-name" value="${p.name}" required />
          </div>
          <div class="modal-form-group">
            <label>Categorie</label>
            <input type="text" id="m-p-cat" value="${p.category}" required />
          </div>
          <div class="modal-form-group">
            <label>Prijs (€)</label>
            <input type="number" step="0.50" id="m-p-price" value="${cleanPriceNum(p.price)}" required />
          </div>
          <div class="modal-form-group">
            <label>Inhoud (bijv. 200 ml)</label>
            <input type="text" id="m-p-volume" value="${p.volume || ''}" />
          </div>
          <div class="modal-form-group">
            <label>Voorraad (stuks)</label>
            <input type="number" id="m-p-stock" value="${p.stock || 10}" />
          </div>
          <div class="modal-form-group">
            <label>Korte Omschrijving</label>
            <textarea id="m-p-desc" rows="3">${p.shortDescription || ''}</textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">Opslaan</button>
          </div>
        </form>
      `);

      document.getElementById('edit-prod-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        p.name = (document.getElementById('m-p-name') as HTMLInputElement).value;
        p.category = (document.getElementById('m-p-cat') as HTMLInputElement).value;
        p.price = cleanPriceNum((document.getElementById('m-p-price') as HTMLInputElement).value);
        p.volume = (document.getElementById('m-p-volume') as HTMLInputElement).value;
        p.stock = parseInt((document.getElementById('m-p-stock') as HTMLInputElement).value);
        p.shortDescription = (document.getElementById('m-p-desc') as HTMLTextAreaElement).value;
        saveStoredProducts(prodData);
        closeModal();
      });
    }

    // Delete Product
    if (target.classList.contains('btn-del-prod')) {
      const idx = Number(target.dataset.idx);
      if (confirm('Weet u zeker dat u dit product wilt verwijderen uit de webshop?')) {
        const prodData = getStoredProducts();
        prodData.splice(idx, 1);
        saveStoredProducts(prodData);
      }
    }

    // Add Product
    if (target.id === 'btn-add-product') {
      openModal('Nieuw Product Toevoegen', `
        <form id="add-prod-form">
          <div class="modal-form-group">
            <label>Productnaam</label>
            <input type="text" id="m-p-name" placeholder="Dr. Baumann..." required />
          </div>
          <div class="modal-form-group">
            <label>Categorie</label>
            <select id="m-p-cat">
              <option value="Dr. Baumann">Dr. Baumann</option>
              <option value="Gezichtsverzorging">Gezichtsverzorging</option>
              <option value="Serums & Olie">Serums & Olie</option>
              <option value="Cadeaubonnen">Cadeaubonnen</option>
            </select>
          </div>
          <div class="modal-form-group">
            <label>Prijs (€)</label>
            <input type="number" step="0.50" id="m-p-price" placeholder="29.95" required />
          </div>
          <div class="modal-form-group">
            <label>Inhoud</label>
            <input type="text" id="m-p-volume" placeholder="Bijv. 150 ml" />
          </div>
          <div class="modal-form-group">
            <label>Voorraad</label>
            <input type="number" id="m-p-stock" value="10" />
          </div>
          <div class="modal-form-group">
            <label>Korte Omschrijving</label>
            <textarea id="m-p-desc" rows="3" placeholder="Beschrijving van het product..."></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">+ Toevoegen</button>
          </div>
        </form>
      `);

      document.getElementById('add-prod-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const prodData = getStoredProducts();
        const newProduct = {
          id: 'prod-' + Date.now(),
          name: (document.getElementById('m-p-name') as HTMLInputElement).value,
          category: (document.getElementById('m-p-cat') as HTMLSelectElement).value,
          price: cleanPriceNum((document.getElementById('m-p-price') as HTMLInputElement).value),
          volume: (document.getElementById('m-p-volume') as HTMLInputElement).value || '100 ml',
          stock: parseInt((document.getElementById('m-p-stock') as HTMLInputElement).value) || 10,
          shortDescription: (document.getElementById('m-p-desc') as HTMLTextAreaElement).value,
          image: '/images/products.png'
        };
        prodData.push(newProduct);
        saveStoredProducts(prodData);
        closeModal();
      });
    }

    // Add Review
    if (target.id === 'btn-add-review') {
      openModal('Nieuwe Google Review Toevoegen', `
        <form id="add-rev-form">
          <div class="modal-form-group">
            <label>Klantnaam</label>
            <input type="text" id="m-r-author" placeholder="Bijv. Monique V." required />
          </div>
          <div class="modal-form-group">
            <label>Behandeling / Dienst</label>
            <input type="text" id="m-r-treat" placeholder="Bijv. Beauty Treatment 60 min" required />
          </div>
          <div class="modal-form-group">
            <label>Beoordelingstekst</label>
            <textarea id="m-r-comment" rows="4" placeholder="Schrijf de review tekst..." required></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">+ Toevoegen</button>
          </div>
        </form>
      `);

      document.getElementById('add-rev-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const revData = getStoredReviews();
        const newRev = {
          id: 'rev-' + Date.now(),
          author: (document.getElementById('m-r-author') as HTMLInputElement).value,
          treatment: (document.getElementById('m-r-treat') as HTMLInputElement).value,
          comment: (document.getElementById('m-r-comment') as HTMLTextAreaElement).value,
          rating: 5
        };
        revData.unshift(newRev);
        saveStoredReviews(revData);
        closeModal();
      });
    }

    // Delete Review
    if (target.classList.contains('btn-del-rev')) {
      const idx = Number(target.dataset.idx);
      if (confirm('Weet u zeker dat u deze review wilt verwijderen?')) {
        const revData = getStoredReviews();
        revData.splice(idx, 1);
        saveStoredReviews(revData);
      }
    }

    // Edit Review
    if (target.classList.contains('btn-edit-rev')) {
      const idx = Number(target.dataset.idx);
      const revData = getStoredReviews();
      const r = revData[idx];
      if (!r) return;

      openModal('Review Bewerken', `
        <form id="edit-rev-form">
          <div class="modal-form-group">
            <label>Klantnaam</label>
            <input type="text" id="m-r-author" value="${r.author}" required />
          </div>
          <div class="modal-form-group">
            <label>Behandeling</label>
            <input type="text" id="m-r-treat" value="${r.treatment}" required />
          </div>
          <div class="modal-form-group">
            <label>Beoordelingstekst</label>
            <textarea id="m-r-comment" rows="4" required>${r.comment}</textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('modal-close-btn').click()">Annuleren</button>
            <button type="submit" class="btn btn-primary btn-sm">Opslaan</button>
          </div>
        </form>
      `);

      document.getElementById('edit-rev-form')?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        r.author = (document.getElementById('m-r-author') as HTMLInputElement).value;
        r.treatment = (document.getElementById('m-r-treat') as HTMLInputElement).value;
        r.comment = (document.getElementById('m-r-comment') as HTMLTextAreaElement).value;
        saveStoredReviews(revData);
        closeModal();
      });
    }
  });
</script>
