---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappWidget from '../components/WhatsappWidget.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import CallBackWidget from '../components/CallBackWidget.astro';
import siteConfig from '../../public/site-config.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = `${siteConfig.clientName} - Praktijk voor Persoonlijke Aandacht | Georgette Noordberger`,
  description = "Praktijk voor professionele voetreflextherapie in Groningen. Behandeling van rugklachten, stress, burn-out, zwangerschapsklachten en Oncoreflex. Erkend & vergoed door zorgverzekeraars.",
  canonical = "https://www.voetreflextherapeutgroningen.nl",
  image = "/images/logo-voeten.png"
} = Astro.props;

const shareImageUrl = image.startsWith('http') ? image : `https://www.${siteConfig.domain}${image}`;

const isSeoActive = siteConfig.modules?.seo !== false;
const isWhatsappActive = siteConfig.modules?.whatsapp === true || siteConfig.modules?.whatsappWidget === true;
const isCookiesActive = siteConfig.modules?.cookies === true || siteConfig.modules?.cookieBanner === true;
const isAnnouncementActive = siteConfig.modules?.announcement === true || siteConfig.modules?.announcementBar === true;
const isAccessibilityActive = siteConfig.modules?.accessibility !== false;
const isCallbackActive = siteConfig.modules?.callback === true || siteConfig.modules?.callBack === true;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "MedicalBusiness", "ProfessionalService"],
      "@id": `https://www.${siteConfig.domain}/#organization`,
      "name": siteConfig.clientName,
      "url": `https://www.${siteConfig.domain}`,
      "logo": `https://www.${siteConfig.domain}/images/logo-voeten.png`,
      "image": `https://www.${siteConfig.domain}/images/logo-voeten.png`,
      "telephone": siteConfig.phoneDisplay,
      "email": siteConfig.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address?.street || "Bieslookstraat 31 unit A5/2",
        "addressLocality": siteConfig.address?.city || "Groningen",
        "postalCode": siteConfig.address?.postalCode || "9731 HH",
        "addressCountry": "NL"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/voetreflextherapeutgroningen",
        "https://nl.wikipedia.org/wiki/Groningen_(stad)"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preload" as="image" href="/images/consult-2.webp" type="image/webp" fetchpriority="high" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" />
  </noscript>
  <link rel="icon" type="image/png" href="/images/logo-voeten.png" />
  <link rel="shortcut icon" href="/images/logo-voeten.png" />
  <link rel="apple-touch-icon" href="/images/logo-voeten.png" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {isSeoActive && (
    <>
      <!-- Open Graph / WhatsApp / Facebook -->
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={shareImageUrl} />
      <meta property="og:image:secure_url" content={shareImageUrl} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:locale" content="nl_NL" />

      <!-- Twitter -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={shareImageUrl} />

      <!-- Schema.org Rich Structured Data -->
      <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    </>
  )}
</head>
<body>
  {isAnnouncementActive && <AnnouncementBar />}
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  {(isWhatsappActive || isCallbackActive) && (
    <div class="floating-actions-dock">
      {isWhatsappActive && <WhatsappWidget />}
      {isCallbackActive && <CallBackWidget />}
    </div>
  )}
  {isAccessibilityActive && <AccessibilityWidget />}
  {isCookiesActive && <CookieBanner />}

  <style is:global>
    .floating-actions-dock {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: 12px;
      z-index: 9990;
      pointer-events: none;
    }
    .floating-actions-dock > * {
      pointer-events: auto;
      position: static !important;
    }
    @media (max-width: 768px) {
      .floating-actions-dock {
        flex-direction: column-reverse;
        bottom: 20px;
        right: 20px;
        gap: 10px;
        align-items: flex-end;
      }
    }
  </style>
</body>
</html>
