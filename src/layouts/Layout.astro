---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappWidget from '../components/WhatsappWidget.astro';
import CookieBanner from '../components/CookieBanner.astro';
import siteConfig from '../../public/site-config.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Voetreflextherapeut Groningen - Voor persoonlijke aandacht | Georgette Noordberger",
  description = "Praktijk voor professionele voetreflextherapie in Groningen. Behandeling van rugklachten, stress, burn-out, zwangerschapsklachten en Oncoreflex. Erkend & vergoed door zorgverzekeraars.",
  canonical = "https://www.voetreflextherapeutgroningen.nl",
  image = "/images/logo-voeten.png"
} = Astro.props;

const shareImageUrl = image.startsWith('http') ? image : `https://www.${siteConfig.domain}${image}`;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "MedicalBusiness", "ProfessionalService"],
      "@id": `https://www.${siteConfig.domain}/#organization`,
      "name": siteConfig.clientName,
      "url": `https://www.${siteConfig.domain}`,
      "logo": `https://www.${siteConfig.domain}/images/logo-voeten.png`,
      "image": `https://www.${siteConfig.domain}/images/logo-voeten.png`,
      "telephone": siteConfig.phoneDisplay,
      "email": siteConfig.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address.street,
        "addressLocality": siteConfig.address.city,
        "postalCode": siteConfig.address.postalCode,
        "addressCountry": "NL"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/voetreflextherapeutgroningen",
        "https://nl.wikipedia.org/wiki/Groningen_(stad)"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/images/logo-voeten.png" />
  <link rel="shortcut icon" href="/images/logo-voeten.png" />
  <link rel="apple-touch-icon" href="/images/logo-voeten.png" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {siteConfig.modules.seo && (
    <>
      <!-- Open Graph / WhatsApp / Facebook -->
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={shareImageUrl} />
      <meta property="og:image:secure_url" content={shareImageUrl} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:locale" content="nl_NL" />

      <!-- Twitter -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={shareImageUrl} />

      <!-- Schema.org Rich Structured Data -->
      <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    </>
  )}
</head>
<body>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  {(siteConfig.modules?.whatsapp !== false && siteConfig.modules?.whatsappWidget !== false) && <WhatsappWidget />}
  <CookieBanner />

  <script>
    // Universal BitbloX Module Enforcer for Mobile & Desktop
    function applyModuleSwitches() {
      const keys = ['blog', 'seo', 'geoAiVindbaarheid', 'whatsappWidget', 'stedenMicrosites', 'googleReviews', 'faqSection', 'contactForm'];
      
      keys.forEach(key => {
        const isOff = localStorage.getItem('bitblox_module_' + key) === 'false';
        if (!isOff) return;

        if (key === 'blog') {
          document.querySelectorAll('a[href="/blog"], a[href^="/blog/"]').forEach(el => {
            const li = el.closest('li');
            if (li) (li as HTMLElement).style.setProperty('display', 'none', 'important');
            else (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }

        if (key === 'stedenMicrosites') {
          document.querySelectorAll('.regio-footer-col, a[href^="/regio/"]').forEach(el => {
            const container = el.closest('.footer-col') || el.closest('li');
            if (container) (container as HTMLElement).style.setProperty('display', 'none', 'important');
            else (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }

        if (key === 'whatsappWidget') {
          document.querySelectorAll('.whatsapp-float').forEach(el => {
            (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }

        if (key === 'googleReviews') {
          document.querySelectorAll('.reviews-section, .reviews-carousel-wrapper').forEach(el => {
            (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }

        if (key === 'faqSection') {
          document.querySelectorAll('.faq-section, #faq').forEach(el => {
            (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }

        if (key === 'contactForm') {
          document.querySelectorAll('.contact-form-card, #contact-form').forEach(el => {
            (el as HTMLElement).style.setProperty('display', 'none', 'important');
          });
        }
      });
    }

    // Run on load and DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyModuleSwitches);
    } else {
      applyModuleSwitches();
    }
  </script>
</body>
</html>
