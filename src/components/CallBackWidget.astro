---
import siteConfig from '../../public/site-config.json';

const waNumber = siteConfig.whatsapp || '31638118341';
const phoneDisplay = siteConfig.phoneDisplay || '06 38118341';
---

<div id="callbackWidget" class="callback-widget">
  <button id="openCallbackModalBtn" class="callback-trigger-btn" aria-label="Bel-me-terug verzoek">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>Bel Mij Terug</span>
  </button>

  <!-- Modal -->
  <div id="callbackModal" class="callback-modal" style="display: none;">
    <div class="callback-modal-content">
      <div class="callback-modal-header">
        <h4>📞 Bel-Me-Terug Verzoek</h4>
        <button id="closeCallbackModalBtn" class="callback-modal-close">&times;</button>
      </div>
      <p class="callback-modal-desc">
        Laat uw telefoonnummer achter en Georgette belt u spoedig terug voor vrijblijvend advies of het inplannen van een consult.
      </p>
      <form id="callbackForm" class="callback-form">
        <input type="tel" id="callbackPhone" placeholder="Uw telefoonnummer (bijv. 06 12345678)..." required pattern="[0-9+ -]{8,15}" />
        <button type="submit" class="btn btn-primary btn--full">🌿 Verstuur Belverzoek</button>
      </form>
      <div id="callbackSuccess" class="callback-success" style="display: none;">
        ✅ Bedankt! Uw verzoek is ontvangen. Georgette neemt zo spoedig mogelijk contact met u op.
      </div>
    </div>
  </div>
</div>

<style>
  .callback-widget {
    position: fixed;
    bottom: 28px;
    right: 195px;
    z-index: 998;
  }

  .callback-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #143322;
    border: 1px solid rgba(32, 130, 84, 0.5);
    color: #4ade80;
    padding: 12px 18px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5), 0 0 16px rgba(32, 130, 84, 0.2);
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .callback-trigger-btn:hover {
    background: #208254;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(32, 130, 84, 0.4);
  }

  @media (max-width: 768px) {
    .callback-widget {
      bottom: 84px;
      right: 20px;
    }
    .callback-trigger-btn {
      padding: 10px 14px;
      font-size: 0.8rem;
    }
  }

  .callback-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999999;
    padding: 20px;
  }

  .callback-modal-content {
    background: #101c15;
    border: 1px solid rgba(32, 130, 84, 0.4);
    border-radius: 16px;
    padding: 28px 24px;
    max-width: 380px;
    width: 100%;
    box-shadow: 0 24px 60px rgba(0,0,0,0.8), 0 0 30px rgba(32, 130, 84, 0.2);
    animation: scaleModal 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes scaleModal {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .callback-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .callback-modal-header h4 {
    margin: 0;
    font-size: 1.05rem;
    color: #ffffff;
    font-weight: 700;
  }

  .callback-modal-close {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
  }

  .callback-modal-desc {
    font-size: 0.83rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0 0 16px 0;
  }

  .callback-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .callback-form input {
    width: 100%;
    padding: 12px 16px;
    background: #172c20;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.9rem;
  }

  .callback-form input:focus {
    border-color: #208254;
    outline: none;
  }

  .btn--full {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    font-weight: 700;
  }

  .callback-success {
    margin-top: 14px;
    padding: 12px;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.35);
    border-radius: 8px;
    color: #4ade80;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 640px) {
    .callback-widget {
      bottom: 20px;
      right: 20px;
    }
  }
</style>

<script is:inline define:vars={{ waNumber }}>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('openCallbackModalBtn');
    const closeBtn = document.getElementById('closeCallbackModalBtn');
    const modal = document.getElementById('callbackModal');
    const form = document.getElementById('callbackForm');
    const phoneInput = document.getElementById('callbackPhone');
    const successBox = document.getElementById('callbackSuccess');

    if (!modal) return;

    if (openBtn) {
      openBtn.addEventListener('click', () => {
        modal.style.display = 'flex';
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.style.display = 'none';
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const phone = phoneInput ? phoneInput.value.trim() : '';
        if (!phone) return;

        form.style.display = 'none';
        if (successBox) successBox.style.display = 'block';

        const textMsg = encodeURIComponent(`📞 Nieuw Bel-Me-Terug verzoek ontvangen via Voetreflextherapeut Groningen website!\nTelefoonnummer: ${phone}\nTijdstip: ${new Date().toLocaleTimeString('nl-NL')}`);
        const waUrl = `https://wa.me/${waNumber}?text=${textMsg}`;
        window.open(waUrl, '_blank');

        setTimeout(() => {
          modal.style.display = 'none';
        }, 2500);
      });
    }
  });
</script>
