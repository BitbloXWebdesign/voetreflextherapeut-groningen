---
import siteConfig from '../../public/site-config.json';
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-grid">
      <!-- Col 1: About & NAP -->
      <div class="footer-col">
        <img src="/images/logo-voeten.png" alt={siteConfig.clientName} class="footer-logo" width="160" height="45" />
        <p class="footer-desc">
          Praktijk voor professionele voetreflextherapie, zwangerschapsmassage, Oncoreflex en natuurgeneeskundige ondersteuning door Georgette Noordberger in Groningen.
        </p>
        <div class="nap-details">
          <p><strong>Adres:</strong> {siteConfig.address.street}, {siteConfig.address.postalCode} {siteConfig.address.city}</p>
          <p><strong>Telefoon:</strong> <a href={`tel:${siteConfig.phoneDisplay.replace(/\s+/g, '')}`}>{siteConfig.phoneDisplay}</a></p>
          <p><strong>E-mail:</strong> <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <h4 class="footer-title">Navigatie</h4>
        <ul class="footer-links">
          <li><a href="/">Welkom & Home</a></li>
          <li><a href="/over-mij">Over Georgette Noordberger</a></li>
          <li><a href="/voetreflextherapie">Wat is Voetreflexologie?</a></li>
          <li><a href="/consulten">Behandelingen & Consulten</a></li>
          <li><a href="/prijzen">Tarieven & Vergoedingen</a></li>
          {siteConfig.modules.blog && <li><a href="/blog">Kennisbank & Artikelen</a></li>}
          <li><a href="/contact">Contact & Afspraak</a></li>
        </ul>
      </div>

      <!-- Col 3: Regio Landingspagina's -->
      {siteConfig.modules.stedenMicrosites && (
        <div class="footer-col regio-footer-col">
          <h4 class="footer-title">Werkgebied Regio Groningen</h4>
          <ul class="footer-links">
            <li><a href="/regio/haren">Voetreflextherapeut Haren</a></li>
            <li><a href="/regio/hoogezand">Voetreflextherapeut Hoogezand</a></li>
            <li><a href="/regio/winsum">Voetreflextherapeut Winsum</a></li>
            <li><a href="/regio/veendam">Voetreflextherapeut Veendam</a></li>
            <li><a href="/regio/bedum">Voetreflextherapeut Bedum</a></li>
          </ul>
        </div>
      )}

      <!-- Col 4: Certificeringen & Bedrijfsgegevens -->
      <div class="footer-col">
        <h4 class="footer-title">Beroepsverenigingen & Kwaliteit</h4>
        <p class="small-text">
          Aangesloten bij CAT Vergoedbaar, RBCZ, Kwaliteitstherapeuten, GAT & Netwerk Massage bij Kanker.
        </p>
        <div class="badge-mini-grid">
          <a href="https://catvergoedbaar.nl/" target="_blank" rel="noopener noreferrer" title="CAT Vergoedbaar"><img src="/images/cat-badge.png" alt="CAT Vergoedbaar" /></a>
          <a href="https://kwaliteitstherapeuten.nl/" target="_blank" rel="noopener noreferrer" title="Kwaliteitstherapeuten"><img src="/images/kwaliteitstherapeuten-badge.png" alt="Kwaliteitstherapeuten" /></a>
          <a href="https://www.rbcz.nu/" target="_blank" rel="noopener noreferrer" title="RBCZ Register"><img src="/images/rbcz-badge.png" alt="RBCZ" /></a>
          <a href="https://www.batverzekeringen.nl/" target="_blank" rel="noopener noreferrer" title="BAT Beroepsverzekering"><img src="/images/bat-badge.png" alt="BAT Verzekering" /></a>
          <a href="https://www.gatgeschillen.nl/" target="_blank" rel="noopener noreferrer" title="GAT Geschillen"><img src="/images/gat-badge.png" alt="GAT" /></a>
          <a href="https://www.oncoreflex.nl/" target="_blank" rel="noopener noreferrer" title="Oncoreflex Master"><img src="/images/oncoreflex-badge.png" alt="Oncoreflex" /></a>
          <a href="https://www.gikp.nl/" target="_blank" rel="noopener noreferrer" title="GIKP Professional"><img src="/images/gikp-badge.png" alt="GIKP" /></a>
        </div>
        <div class="legal-info">
          <p><strong>KvK:</strong> {siteConfig.kvk} | <strong>BTW:</strong> {siteConfig.btw} (Vrijgesteld)</p>
          <p><strong>IBAN:</strong> {siteConfig.iban}</p>
        </div>

        <!-- 3 Officiële Beroepsdocumenten & Formulieren -->
        <div class="footer-docs-box mt-2">
          <p class="footer-docs-title"><strong>Praktijkdocumenten:</strong></p>
          <ul class="footer-docs-list">
            <li><a href="/documents/privacy-statement.pdf" target="_blank" rel="noopener noreferrer">📄 Privacy Statement (PDF)</a></li>
            <li><a href="/documents/behandelovereenkomst.pdf" target="_blank" rel="noopener noreferrer">📄 Behandelovereenkomst (PDF)</a></li>
            <li><a href="/documents/toestemmingsformulier-minderjarige.pdf" target="_blank" rel="noopener noreferrer">📄 Toestemmingsformulier Minderjarigen (PDF)</a></li>
          </ul>
        </div>

        <div class="footer-klachtenregeling mt-2">
          <p class="footer-klachten-text">
            <strong>Wkkgz Klachtenregeling:</strong> Ik val als Complementaire Kwaliteitstherapeut en CAT-vergoedbaar therapeut onder Wkkgz-klachtrecht en tuchtrecht bij de Geschilleninstantie Alternatieve Therapeuten (GAT). Voor meer informatie zie <a href="https://gatgeschillen.nl/" target="_blank" rel="noopener noreferrer">https://gatgeschillen.nl/</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>Copyright &copy; {new Date().getFullYear()} | BitbloX</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark-bg);
    color: #94a3b8;
    font-size: 0.9rem;
    margin-top: auto;
  }

  .footer-top {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .footer-col {
    flex: 1 1 240px;
  }

  .footer-col:first-child {
    flex: 1.2 1 280px;
    max-width: 360px;
  }

  .footer-col:last-child {
    flex: 1.4 1 320px;
    max-width: 440px;
  }

  .footer-logo {
    height: 44px;
    width: auto;
    margin-bottom: 1rem;
    filter: brightness(0) invert(1);
  }

  .footer-desc {
    margin-bottom: 1.2rem;
    line-height: 1.6;
  }

  .nap-details p {
    margin-bottom: 0.4rem;
  }

  .nap-details a {
    color: #e2e8f0;
  }

  .nap-details a:hover {
    color: var(--color-primary);
  }

  .footer-title {
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 2px;
    background-color: var(--color-primary);
  }

  .footer-links {
    list-style: none;
  }

  .footer-links li {
    margin-bottom: 0.6rem;
  }

  .footer-links a {
    color: #94a3b8;
    transition: var(--transition);
  }

  .footer-links a:hover {
    color: var(--color-primary);
    padding-left: 4px;
  }

  .small-text {
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .badge-mini-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }

  .badge-mini-grid img {
    height: 38px;
    width: auto;
    object-fit: contain;
    background: rgba(255,255,255,0.08);
    padding: 4px;
    border-radius: 4px;
  }

  .legal-info {
    font-size: 0.825rem;
    color: #64748b;
  }

  .footer-docs-box {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-docs-title {
    font-size: 0.85rem;
    color: #e2e8f0;
    margin-bottom: 0.4rem;
  }

  .footer-docs-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-docs-list li {
    margin-bottom: 0.4rem;
  }

  .footer-docs-list a {
    color: #cbd5e1;
    font-size: 0.82rem;
    text-decoration: none;
    transition: var(--transition);
    display: inline-block;
  }

  .footer-docs-list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    transform: translateX(3px);
  }

  .footer-klachten-text {
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.45;
    background-color: rgba(255, 255, 255, 0.04);
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-klachten-text a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-bottom {
    background-color: #0b0f17;
    padding: 1.2rem 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    font-size: 0.85rem;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .bitblox-credit a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>

<script>
  if (localStorage.getItem('bitblox_module_blog') === 'false') {
    document.querySelectorAll('.footer-links a[href="/blog"]').forEach(link => {
      const parentLi = link.closest('li');
      if (parentLi) parentLi.style.display = 'none';
    });
  }

  if (localStorage.getItem('bitblox_module_stedenMicrosites') === 'false') {
    const regioCol = document.querySelector('.regio-footer-col') as HTMLElement;
    if (regioCol) regioCol.style.display = 'none';
  }
</script>
