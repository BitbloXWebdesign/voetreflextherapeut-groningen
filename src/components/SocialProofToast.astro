---
---

<div id="socialProofToast" class="social-proof-toast" aria-live="polite">
  <div class="toast-avatar" id="toastIcon">🌿</div>
  <div class="toast-body">
    <strong id="toastTitle" class="toast-title">Nieuw Consult Inepland</strong>
    <p id="toastDesc" class="toast-desc">Cliënt uit Haren boekt een intake voor stress & burn-out.</p>
    <span id="toastTime" class="toast-time">6 minuten geleden</span>
  </div>
  <button id="closeToastBtn" class="toast-close">&times;</button>
</div>

<style>
  .social-proof-toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    max-width: 320px;
    width: calc(100% - 48px);
    background: rgba(15, 24, 18, 0.96);
    border: 1px solid rgba(32, 130, 84, 0.4);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 12px;
    padding: 12px 14px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.5), 0 0 16px rgba(32, 130, 84, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 998;
    transform: translateY(120px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    pointer-events: none;
  }

  .social-proof-toast.show {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .toast-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(32, 130, 84, 0.2);
    border: 1px solid rgba(32, 130, 84, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .toast-body {
    flex: 1;
    min-width: 0;
  }

  .toast-title {
    display: block;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .toast-desc {
    margin: 0 0 4px 0;
    font-size: 0.74rem;
    color: #94a3b8;
    line-height: 1.35;
  }

  .toast-time {
    display: inline-block;
    font-size: 0.68rem;
    color: #4ade80;
    font-weight: 600;
  }

  .toast-close {
    background: none;
    border: none;
    color: #64748b;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 2px 4px;
    align-self: flex-start;
    transition: color 0.2s;
  }

  .toast-close:hover {
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .social-proof-toast {
      bottom: 80px;
      left: 14px;
      right: 14px;
      max-width: calc(100% - 28px);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toast = document.getElementById('socialProofToast');
    const titleEl = document.getElementById('toastTitle');
    const descEl = document.getElementById('toastDesc');
    const timeEl = document.getElementById('toastTime');
    const iconEl = document.getElementById('toastIcon');
    const closeBtn = document.getElementById('closeToastBtn');

    if (!toast) return;

    const items = [
      { icon: '🌿', title: 'Nieuw Consult Inepland', desc: 'Cliënt uit Haren boekt een intake voor stress & burn-out.', time: '6 min geleden' },
      { icon: '⭐', title: 'Ervaring van Cliënt', desc: 'Marloes & Sven: "Zeer kundig, rustgevend en vergoed door verzekering."', time: '21 min geleden' },
      { icon: '🌸', title: 'Zwangerschap Behandeling', desc: 'Cliënt uit Groningen start met het ontspannende NIBYS traject.', time: '45 min geleden' }
    ];

    let currentIndex = 0;
    let toastInterval;

    function showNextToast() {
      const item = items[currentIndex];
      if (iconEl) iconEl.textContent = item.icon;
      if (titleEl) titleEl.textContent = item.title;
      if (descEl) descEl.textContent = item.desc;
      if (timeEl) timeEl.textContent = item.time;

      toast.classList.add('show');

      setTimeout(() => {
        toast.classList.remove('show');
      }, 5000);

      currentIndex = (currentIndex + 1) % items.length;
    }

    setTimeout(() => {
      showNextToast();
      toastInterval = setInterval(showNextToast, 18000);
    }, 4000);

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        toast.classList.remove('show');
        if (toastInterval) clearInterval(toastInterval);
      });
    }
  });
</script>
